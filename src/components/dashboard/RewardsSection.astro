---
import type { Reward } from '../../data/dashboard/types';
import RewardCard from './RewardCard.astro';

interface Props {
  rewards: Reward[];
}

const { rewards } = Astro.props;
---

<section class="dash-section dash-rewards" aria-label="Rewards">
  <div class="d-flex align-items-center justify-content-between dash-section-title">
    <h2 class="h5 mb-0">Rewards</h2>
    <div class="dash-rewards-nav d-none d-md-flex gap-2">
      <button type="button" class="dash-scroll-btn" data-direction="-1" aria-label="Scroll rewards left">
        <i class="fa-solid fa-chevron-left dash-icon" aria-hidden="true"></i>
      </button>
      <button type="button" class="dash-scroll-btn" data-direction="1" aria-label="Scroll rewards right">
        <i class="fa-solid fa-chevron-right dash-icon" aria-hidden="true"></i>
      </button>
    </div>
  </div>
  <div class="dash-rewards-viewport">
    <ul class="dash-rewards-track list-unstyled mb-0">
      {rewards.map((reward) => (
        <RewardCard reward={reward} />
      ))}
    </ul>
  </div>
</section>

<style>
  .dash-rewards-track {
    display: flex;
    gap: var(--dash-space-3);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-bottom: var(--dash-space-2);
    scrollbar-width: none;
  }

  .dash-rewards-track::-webkit-scrollbar {
    display: none;
  }

  /* Subtle right-edge fade; hidden once the track is scrolled to its end. */
  .dash-rewards-viewport {
    position: relative;
  }

  .dash-rewards-viewport::before,
  .dash-rewards-viewport::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--dash-space-6);
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.15s;
  }

  .dash-rewards-viewport::before {
    left: 0;
    background: linear-gradient(to left, transparent, var(--dash-surface));
    opacity: 0;
  }

  .dash-rewards-viewport::after {
    right: 0;
    background: linear-gradient(to right, transparent, var(--dash-surface));
  }

  .dash-rewards-viewport.is-scrolled::before {
    opacity: 1;
  }

  .dash-rewards-viewport.is-at-end::after {
    opacity: 0;
  }

  .dash-rewards .dash-section-title {
    min-height: var(--dash-control-sm);
  }

  /* Global button rule forces a transparent border, so the ring is drawn with an inset shadow. */
  .dash-scroll-btn {
    width: var(--dash-control-sm);
    height: var(--dash-control-sm);
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--dash-border-subtle);
    background: var(--dash-surface);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .dash-scroll-btn:hover {
    background: var(--dash-surface-subtle);
  }
</style>

<script>
  // Wire each rewards scroller's prev/next buttons to its own track (scoped via closest()).
  document.querySelectorAll<HTMLElement>('.dash-rewards').forEach((section) => {
    const track = section.querySelector<HTMLElement>('.dash-rewards-track');
    const viewport = track?.parentElement;
    const updateFade = () => {
      if (!track || !viewport) return;
      viewport.classList.toggle('is-scrolled', track.scrollLeft > 2);
      viewport.classList.toggle('is-at-end', track.scrollLeft + track.clientWidth >= track.scrollWidth - 2);
    };
    track?.addEventListener('scroll', updateFade, { passive: true });
    window.addEventListener('resize', updateFade);
    updateFade();
    section.querySelectorAll<HTMLButtonElement>('.dash-scroll-btn').forEach((button) => {
      button.addEventListener('click', () => {
        if (!track) return;
        const direction = Number(button.dataset.direction ?? '1');
        track.scrollBy({ left: direction * 220, behavior: 'smooth' });
      });
    });
  });
</script>
