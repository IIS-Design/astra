---
import type { Referral } from '../../data/dashboard/types';

interface Props {
  referral: Referral;
}

const { referral } = Astro.props;
---

<div class="dash-referral">
  <i class="fa-solid fa-user-plus dash-icon" aria-hidden="true"></i>
  <p class="dash-referral-text mb-0">
    <strong>Refer a friend.</strong> {referral.description}
  </p>
  <div class="dash-referral-action">
    <span class="dash-referral-points">
      <i class="fa-solid fa-star dash-points-icon" aria-hidden="true"></i> {referral.pointsLabel}
    </span>
    <a class="dash-link-cta" href={referral.ctaHref}>{referral.ctaLabel}</a>
  </div>
</div>

<style>
  .dash-referral {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--dash-space-2) var(--dash-space-4);
    margin-top: var(--dash-space-4);
    padding: var(--dash-space-3) var(--dash-space-4);
    background: var(--dash-surface-brand-subtle);
    border: 1px solid var(--dash-border-subtle);
    border-radius: var(--dash-radius-sm);
  }

  .dash-referral-text {
    flex: 1 1 240px;
    min-width: 0;
    font-size: var(--dash-fs-body);
    line-height: 1.4;
    color: var(--dash-text-primary);
  }

  .dash-referral-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--dash-space-4);
    flex: 0 0 auto;
  }

  .dash-referral-points {
    font-size: var(--dash-fs-meta);
    font-weight: 700;
    color: var(--dash-text-primary);
    white-space: nowrap;
  }

  /* Mobile: icon + copy on the first row, points and CTA on their own row. */
  @media (max-width: 575.98px) {
    .dash-referral-action {
      flex: 1 1 100%;
    }
  }
</style>
