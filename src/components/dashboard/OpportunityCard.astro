---
import type { Opportunity } from '../../data/dashboard/types';

interface Props {
  opportunity: Opportunity;
}

const { opportunity } = Astro.props;

// One icon family (Font Awesome solid), navy, used only to distinguish opportunity type.
const iconByType: Record<Opportunity['type'], string> = {
  survey: 'fa-clipboard-list',
  specialStudy: 'fa-flask',
  productTrial: 'fa-box-open',
  diary: 'fa-book',
  featuredPoll: 'fa-square-poll-vertical',
  profileCompletion: 'fa-id-card',
};

const icon = iconByType[opportunity.type];
// Quick, low-effort activities (polls) get a visibly lighter card — same grid, less content.
const isQuick = opportunity.type === 'featuredPoll';
---

<li class={`dash-opp-card ${isQuick ? 'dash-opp-card--quick' : ''}`}>
  <div class="dash-opp-head">
    <i class={`fa-solid ${icon} dash-icon`} aria-hidden="true"></i>
    {opportunity.badge && <span class="badge badge-over-gray">{opportunity.badge}</span>}
  </div>

  <h3 class="h6 dash-opp-title">{opportunity.title}</h3>
  {!isQuick && <p class="dash-opp-desc">{opportunity.description}</p>}

  {opportunity.progress && (
    <div class="progress dash-opp-progress" role="progressbar" aria-valuenow={opportunity.progress.current} aria-valuemin="0" aria-valuemax={opportunity.progress.target}>
      <div class="progress-bar" style={`width: ${Math.round((opportunity.progress.current / opportunity.progress.target) * 100)}%`}></div>
    </div>
  )}

  <div class="dash-opp-footer">
    <p class="dash-opp-points mb-0">
      <i class="fa-solid fa-star dash-points-icon" aria-hidden="true"></i> {opportunity.pointsLabel}
      {opportunity.metaLabel && <span class="dash-opp-sub"> · {opportunity.metaLabel}</span>}
    </p>
    <a class={isQuick ? 'dash-link-cta' : 'btn btn-outline-primary btn-sm'} href={opportunity.ctaHref}>{opportunity.ctaLabel}</a>
  </div>
</li>

<style>
  .dash-opp-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--dash-space-sm);
    background: var(--dash-surface);
    border: 1px solid var(--dash-border-subtle);
    border-radius: var(--dash-radius-sm);
  }

  .dash-opp-card--quick {
    padding: var(--dash-space-xs) var(--dash-space-sm);
    background: var(--dash-surface-subtle);
    border-style: dashed;
  }

  .dash-opp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .dash-opp-title {
    margin-bottom: 4px;
  }

  .dash-opp-desc {
    font-size: 13px;
    color: var(--dash-text-secondary);
    margin-bottom: 0;
  }

  .dash-opp-progress {
    height: 5px;
    margin-top: 10px;
  }

  .dash-opp-footer {
    margin-top: auto;
    padding-top: var(--dash-space-sm);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .dash-opp-points {
    font-size: 13px;
    font-weight: 700;
    color: var(--dash-text-primary);
  }

  .dash-opp-sub {
    font-weight: 400;
    color: var(--dash-text-secondary);
  }
</style>
