---
// Layout shell: main content column + secondary editorial rail.
// The rail collapses below the main column on narrower viewports.
---

<div class="dash-shell">
  <div class="dash-main">
    <slot name="main" />
  </div>
  <aside class="dash-rail" aria-label="Latest from Ipsos iSay Today">
    <slot name="rail" />
  </aside>
</div>

<style>
  .dash-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--dash-space-6);
    align-items: start;
  }

  .dash-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--dash-space-6);
  }

  .dash-rail {
    min-width: 0;
  }

  @media (min-width: 1240px) {
    .dash-shell {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: var(--dash-space-7);
    }

    .dash-rail {
      position: sticky;
      top: var(--dash-space-5);
    }
  }
</style>
